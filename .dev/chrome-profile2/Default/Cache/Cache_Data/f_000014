: 600;\r\n  background: var(--primary);\r\n  border: 1px solid var(--primary);\r\n  border-radius: 6px;\r\n  transition: opacity 0.15s;\r\n}\r\n\r\n.qr-actions button:hover {\r\n  opacity: 0.85;\r\n}\r\n\r\n.qr-code {\r\n  position: relative;\r\n  width: 78px;\r\n  height: 78px;\r\n  background:\r\n    linear-gradient(90deg, #ffffff 9px, transparent 9px) 0 0 / 18px 18px,\r\n    linear-gradient(#ffffff 9px, transparent 9px) 0 0 / 18px 18px,\r\n    var(--accent);\r\n  border: 8px solid #ffffff;\r\n  border-radius: 6px;\r\n}\r\n\r\n.qr-code span {\r\n  position: absolute;\r\n  width: 18px;\r\n  height: 18px;\r\n  background: #18211f;\r\n}\r\n\r\n.qr-code span:nth-child(1) {\r\n  top: 6px;\r\n  left: 6px;\r\n}\r\n\r\n.qr-code span:nth-child(2) {\r\n  right: 8px;\r\n  top: 26px;\r\n}\r\n\r\n.qr-code span:nth-child(3) {\r\n  bottom: 8px;\r\n  left: 28px;\r\n}\r\n\r\n.qr-code span:nth-child(4) {\r\n  right: 10px;\r\n  bottom: 8px;\r\n}\r\n\r\n/* =============================================\r\n   WORKSPACE — flex col, flex-1\r\n   ============================================= */\r\n.company-workspace {\r\n  display: flex;\r\n  flex-direction: column;\r\n  flex: 1;\r\n  min-width: 0;\r\n}\r\n\r\n/* Content area padding */\r\n.page-content {\r\n  flex: 1;\r\n  padding: 20px 24px 32px;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 16px;\r\n}\r\n\r\n/* =============================================\r\n   TOPBAR — ref: h-16, sticky, border-b, bg-card\r\n   ============================================= */\r\n.company-topbar {\r\n  position: sticky;\r\n  top: 0;\r\n  z-index: 10;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: 20px;\r\n  height: 64px;\r\n  padding: 0 24px;\r\n  background: var(--card);\r\n  border-bottom: 1px solid var(--border);\r\n  margin-bottom: 0;\r\n}\r\n\r\n.company-topbar > div:first-child {\r\n  display: flex;\r\n  flex-direction: column;\r\n  line-height: 1.2;\r\n  min-width: 0;\r\n}\r\n\r\n.company-topbar > div:first-child p.eyebrow {\r\n  font-size: 10px;\r\n  font-weight: 500;\r\n  letter-spacing: 0.12em;\r\n  text-transform: uppercase;\r\n  color: var(--muted-foreground);\r\n  margin: 0;\r\n}\r\n\r\n.company-topbar h2 {\r\n  margin: 2px 0 0;\r\n  font-size: 20px;\r\n  font-weight: 600;\r\n  letter-spacing: -0.02em;\r\n  color: var(--foreground);\r\n  white-space: nowrap;\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n}\r\n\r\n/* Main content padding */\r\n.company-workspace > section,\r\n.company-workspace > div:not(.company-topbar) {\r\n  padding: 20px 24px 24px;\r\n}\r\n\r\n.dashboard h3,\r\n.menu-section h3,\r\n.cart-panel h3 {\r\n  margin: 0;\r\n  color: var(--foreground);\r\n}\r\n\r\n/* Remove old oversized topbar h2 — now handled in .company-topbar block above */\r\n\r\n.company-topbar p:not(.eyebrow) {\r\n  margin: 4px 0 0;\r\n  font-size: 13px;\r\n  color: var(--muted-foreground);\r\n}\r\n\r\n\r\n.company-pill {\r\n  flex: 0 0 auto;\r\n  padding: 10px 14px;\r\n  color: #0f3d35;\r\n  font-size: 14px;\r\n  font-weight: 900;\r\n  background: #e7f7ee;\r\n  border: 1px solid #b7e4d0;\r\n  border-radius: 999px;\r\n}\r\n.topbar-add-item-button {\r\n  flex: 0 0 auto;\r\n  min-width: 140px;\r\n  padding: 0 18px;\r\n}\r\n\r\n.metric-grid {\r\n  display: grid;\r\n  grid-template-columns: repeat(4, minmax(0, 1fr));\r\n  gap: 12px;\r\n  margin-bottom: 20px;\r\n}\r\n\r\n.overview-metric-grid {\r\n  grid-template-columns: repeat(3, minmax(0, 1fr));\r\n}\r\n\r\n/* Cards — ref: rounded-xl, border, bg-card, shadow-xs, ring-1 */\r\n.metric-grid div {\r\n  display: grid;\r\n  gap: 6px;\r\n  min-height: 120px;\r\n  padding: 16px;\r\n  background: var(--card);\r\n  border: 1px solid var(--border);\r\n  border-radius: 10px;\r\n  box-shadow: 0 1px 3px oklch(0 0 0 / 6%);\r\n}\r\n\r\n.metric-grid span {\r\n  font-size: 10px;\r\n  font-weight: 500;\r\n  letter-spacing: 0.1em;\r\n  text-transform: uppercase;\r\n  color: var(--muted-foreground);\r\n}\r\n\r\n.metric-grid strong {\r\n  color: var(--foreground);\r\n  overflow-wrap: anywhere;\r\n  font-size: 24px;\r\n  font-weight: 600;\r\n  letter-spacing: -0.02em;\r\n  line-height: 1.1;\r\n}\r\n\r\n.sparkline {\r\n  width: 100%;\r\n  height: 24px;\r\n  margin-top: 4px;\r\n  opacity: 0.9;\r\n}\r\n\r\n.sparkline polyline {\r\n  filter: drop-shadow(0 1px 2px rgba(0, 0, 0, 0.1));\r\n}\r\n\r\n.sparkline-chart {\r\n  width: 100%;\r\n  height: 48px;\r\n  margin-top: auto;\r\n}\r\n\r\n.sparkline-chart path {\r\n  transition: opacity 0.2s ease;\r\n}\r\n\r\n.tabs {\r\n  display: inline-flex;\r\n  gap: 4px;\r\n  padding: 4px;\r\n  background: var(--muted);\r\n  border-radius: 8px;\r\n}\r\n\r\n.tabs button {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 8px;\r\n  min-height: 40px;\r\n  padding: 0 14px;\r\n  color: var(--muted-foreground);\r\n  background: transparent;\r\n  border: 0;\r\n  border-radius: 6px;\r\n  transition: background 0.15s, color 0.15s;\r\n}\r\n\r\n.tabs button.active {\r\n  color: var(--foreground);\r\n  background: var(--card);\r\n  box-shadow: 0 1px 3px oklch(0 0 0 / 8%);\r\n}\r\n\r\n.tabs span {\r\n  display: inline-grid;\r\n  min-width: 22px;\r\n  min-height: 22px;\r\n  place-items: center;\r\n  color: var(--destructive);\r\n  font-size: 12px;\r\n  font-weight: 700;\r\n  background: oklch(from var(--destructive) l c h / 12%);\r\n  border-radius: 999px;\r\n}\r\n\r\n.customer-layout {\r\n  display: grid;\r\n  grid-template-columns: minmax(0, 1fr) 360px;\r\n  gap: 20px;\r\n  align-items: start;\r\n}\r\n\r\n.account-layout {\r\n  display: grid;\r\n  grid-template-columns: minmax(280px, 0.9fr) minmax(360px, 1.1fr);\r\n  gap: 20px;\r\n  align-items: stretch;\r\n}\r\n\r\n.account-form-card,\r\n.account-summary,\r\n.launch-panel,\r\n.link-map,\r\n.mini-list {\r\n  display: grid;\r\n  gap: 18px;\r\n}\r\n\r\n.account-summary {\r\n  align-content: stretch;\r\n}\r\n\r\n.account-form-card,\r\n.launch-panel,\r\n.link-map,\r\n.mini-list {\r\n  padding: 18px;\r\n  background: #ffffff;\r\n  border: 1px solid #e5e7eb;\r\n  border-radius: 8px;\r\n  box-shadow: 0 14px 30px rgba(31, 41, 55, 0.06);\r\n}\r\n\r\n.launch-panel {\r\n  min-height: 100%;\r\n  align-content: start;\r\n  background: #122620;\r\n  border-color: #122620;\r\n}\r\n\r\n.account-form-card h3,\r\n.launch-panel h3,\r\n.link-map h3,\r\n.mini-list h3 {\r\n  margin: 0;\r\n  color: #111827;\r\n  font-size: 24px;\r\n}\r\n\r\n.launch-panel h3 {\r\n  color: #ffffff;\r\n  font-size: 30px;\r\n}\r\n\r\n.launch-panel p,\r\n.muted-copy {\r\n  margin: 8px 0 0;\r\n  color: #667085;\r\n}\r\n\r\n.launch-panel p {\r\n  color: #bed0ca;\r\n}\r\n\r\n.account-form-card {\r\n  grid-column: 1 / -1;\r\n}\r\n.icon-button {\r\n  display: inline-grid;\r\n  width: 42px;\r\n  height: 42px;\r\n  place-items: center;\r\n  color: var(--foreground);\r\n  background: var(--card);\r\n  border: 1px solid var(--border);\r\n  border-radius: 6px;\r\n}\r\n\r\n.icon-button:hover {\r\n  background: var(--muted);\r\n  border-color: var(--muted-foreground);\r\n}\r\n\r\n\r\n.add-item-page {\r\n  display: grid;\r\n  gap: 20px;\r\n}\r\n\r\n.add-item-back-button {\r\n  justify-self: start;\r\n}\r\n\r\n.add-item-head {\r\n  display: block;\r\n}\r\n\r\n.add-item-page .universal-item-form {\r\n  max-width: none;\r\n}\r\n\r\n.setup-list {\r\n  display: grid;\r\n  gap: 12px;\r\n}\r\n\r\n.setup-list div {\r\n  display: grid;\r\n  grid-template-columns: 34px minmax(0, 1fr);\r\n  gap: 2px 12px;\r\n  align-items: start;\r\n  padding: 14px;\r\n  background: rgba(255, 255, 255, 0.08);\r\n  border: 1px solid rgba(255, 255, 255, 0.12);\r\n  border-radius: 8px;\r\n}\r\n\r\n.setup-list span {\r\n  display: grid;\r\n  grid-row: span 2;\r\n  width: 30px;\r\n  height: 30px;\r\n  place-items: center;\r\n  color: #12302a;\r\n  font-weight: 900;\r\n  background: #b9f4d1;\r\n  border-radius: 999px;\r\n}\r\n\r\n.setup-list strong {\r\n  color: #ffffff;\r\n}\r\n\r\n.setup-list small {\r\n  color: #bed0ca;\r\n}\r\n\r\n.metrics-card {\r\