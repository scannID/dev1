const __vite__css = "/* =============================================\r\n   SHELL — matches ref: flex row, bg-background\r\n   ============================================= */\r\n.company-shell {\r\n  display: flex;\r\n  min-height: 100svh;\r\n  background: var(--background);\r\n}\r\n\r\n/* =============================================\r\n   SIDEBAR — white in light, dark in dark mode\r\n   ============================================= */\r\n.company-sidebar {\r\n  position: sticky;\r\n  top: 0;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 12px;\r\n  width: 240px;\r\n  flex-shrink: 0;\r\n  height: 100svh;\r\n  padding: 12px;\r\n  background: var(--sidebar);\r\n  color: var(--sidebar-foreground);\r\n  border-right: 1px solid var(--border);\r\n  overflow-y: auto;\r\n}\r\n\r\n/* Brand row */\r\n.company-sidebar .sidebar-brand {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 10px;\r\n  padding: 4px 4px 0;\r\n}\r\n\r\n.company-sidebar .sidebar-brand-logo {\r\n  flex-shrink: 0;\r\n  width: 32px;\r\n  height: 32px;\r\n  border-radius: 8px;\r\n  object-fit: contain;\r\n  background: transparent;\r\n  padding: 2px;\r\n}\r\n\r\n.company-sidebar .sidebar-brand-text {\r\n  display: flex;\r\n  flex-direction: column;\r\n  line-height: 1.2;\r\n  min-width: 0;\r\n}\r\n\r\n.company-sidebar .sidebar-brand-text strong {\r\n  font-size: 14px;\r\n  font-weight: 600;\r\n  color: var(--foreground);\r\n}\r\n\r\n.company-sidebar .sidebar-brand-text span {\r\n  font-size: 9px;\r\n  font-weight: 500;\r\n  letter-spacing: 0.12em;\r\n  text-transform: uppercase;\r\n  color: var(--muted-foreground);\r\n}\r\n\r\n.eyebrow {\r\n  margin: 0;\r\n  font-size: 10px;\r\n  font-weight: 500;\r\n  letter-spacing: 0.12em;\r\n  text-transform: uppercase;\r\n  color: var(--muted-foreground);\r\n}\r\n\r\n.company-sidebar .eyebrow {\r\n  color: var(--muted-foreground);\r\n}\r\n\r\n/* =============================================\r\n   SIDE NAV — ref style: gap-0.5, rounded-md\r\n   ============================================= */\r\n.side-nav {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 2px;\r\n}\r\n\r\n.side-nav button {\r\n  position: relative;\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 10px;\r\n  width: 100%;\r\n  padding: 8px 10px;\r\n  font-size: 13px;\r\n  font-weight: 500;\r\n  color: var(--muted-foreground);\r\n  text-align: left;\r\n  background: transparent;\r\n  border: 1px solid transparent;\r\n  border-radius: 6px;\r\n  transition: background 0.15s, color 0.15s;\r\n}\r\n\r\n.side-nav button:hover {\r\n  background: var(--sidebar-accent);\r\n  color: var(--sidebar-foreground);\r\n}\r\n\r\n.side-nav button.active {\r\n  background: var(--sidebar-accent);\r\n  color: var(--primary);\r\n  font-weight: 600;\r\n}\r\n\r\n/* Left accent bar on active — signature ref detail */\r\n.side-nav button.active::before {\r\n  content: '';\r\n  position: absolute;\r\n  top: 4px;\r\n  bottom: 4px;\r\n  left: -12px;\r\n  width: 2px;\r\n  border-radius: 0 2px 2px 0;\r\n  background: var(--primary);\r\n}\r\n\r\nbutton,\r\ninput,\r\ntextarea,\r\nselect {\r\n  font: inherit;\r\n}\r\n\r\nbutton {\r\n  cursor: pointer;\r\n}\r\n\r\nbutton:disabled {\r\n  cursor: not-allowed;\r\n  opacity: 0.55;\r\n}\r\n\r\n.business {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: 14px;\r\n  width: 100%;\r\n  min-height: 56px;\r\n  padding: 12px 14px;\r\n  color: #374151;\r\n  text-align: left;\r\n  background: #f9fafb;\r\n  border: 1px solid #e5e7eb;\r\n  border-radius: 8px;\r\n}\r\n\r\n.business.active {\r\n  color: #101412;\r\n  background: #e7f7ee;\r\n}\r\n\r\n.business span {\r\n  font-weight: 800;\r\n}\r\n\r\n.business small {\r\n  color: inherit;\r\n  opacity: 0.75;\r\n}\r\n\r\n.qr-panel {\r\n  display: grid;\r\n  grid-template-columns: 78px minmax(0, 1fr);\r\n  gap: 14px;\r\n  align-items: center;\r\n  margin-top: auto;\r\n  padding: 14px;\r\n  background: #f9fafb;\r\n  border: 1px solid #e5e7eb;\