      "body": {
        "mimeType": "application/json",
        "text": "{\"businessName\":\"Test Cafe\",\"businessType\":\"Restaurant\",\"email\":\"testcafe@example.com\",\"phoneNumber\":\"+256700000001\",\"paymentDestination\":{\"type\":\"MOBILE_MONEY\",\"provider\":\"MTN\",\"number\":\"+256700000001\",\"accountName\":\"Test Cafe\"},\"termsAccepted\":true}"
