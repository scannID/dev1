      "_type": "request",
      "name": "Get Keycloak Token (Merchant)",
      "method": "POST",
      "url": "{{ _.keycloak_url }}/realms/{{ _.realm }}/protocol/openid-connect/token",
      "body": {
        "mimeType": "application/x-www-form-urlencoded",
        "params": [
          { "name": "grant_type", "value": "password" },
          { "name": "client_id", "value": "{{ _.client_id }}" },
          { "name": "username", "value": "merchant@example.com" },
          { "name": "password", "value": "your-password" }
