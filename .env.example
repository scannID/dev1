# API Configuration
VITE_API_BASE_URL=http://localhost:4000/api
VITE_SCAN_BASE_URL=http://localhost:5173
VITE_WS_BASE_URL=ws://localhost:4000
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=scanny
VITE_KEYCLOAK_CLIENT_ID=scanny-client

# Production examples:
# VITE_API_BASE_URL=https://api.scanny.app/api
# VITE_SCAN_BASE_URL=https://scanny.app
# VITE_WS_BASE_URL=wss://api.scanny.app
# VITE_KEYCLOAK_URL=https://auth.scanny.app

# Docker Compose (local defaults; replace every secret in production)
POSTGRES_DB=scanny
POSTGRES_USER=scanny
POSTGRES_PASSWORD=scanny-local
POSTGRES_PORT=5432

REDIS_PASSWORD=scanny-local
REDIS_PORT=6379

KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_PORT=8080
KEYCLOAK_REALM=scanny
KEYCLOAK_BACKEND_CLIENT_ID=scanny-backend
KEYCLOAK_BACKEND_CLIENT_SECRET=replace-with-a-long-random-secret

# Production frontend client IDs
VITE_ADMIN_KEYCLOAK_CLIENT_ID=scanny-admin
